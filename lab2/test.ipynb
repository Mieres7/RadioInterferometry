   "source": [
    "from numba import cuda\n",
    "\n",
    "@cuda.jit\n",
    "def test(a):\n",
    "    i = cuda.grid(1)\n",
    "    if i < a.size:\n",
    "        a[i] += 1\n",
    "\n",
    "import numpy as np\n",
    "import cupy as cp\n",
    "\n",
    "a = cp.arange(1000, dtype=cp.float32)\n",
    "test[32, 128](a)\n",
    "cuda.synchronize()\n",
    "print(\"OK!\", a[0:5])\n"
   ]
  }
 ],
